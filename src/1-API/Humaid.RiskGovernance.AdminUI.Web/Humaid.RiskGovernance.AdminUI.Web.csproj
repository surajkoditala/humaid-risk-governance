<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <!-- Pins the transitive Microsoft.OpenApi dependency past 2.0.0's known high-severity
         vulnerability (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Phase 4 - observability. Registered conditionally in Program.cs only when
         APPLICATIONINSIGHTS_CONNECTION_STRING is set - see ops/README.md. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <!-- Key Vault as a config source - registered conditionally in Program.cs only when
         PEP_KEY_VAULT is set, so it stays highest-priority (overrides env vars/appsettings for
         any key it holds) without requiring it locally. Azure.Identity is already a transitive
         dependency via .Services/.DA, referenced explicitly here since Program.cs uses
         DefaultAzureCredential directly now. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\2-Infrastructure\Humaid.RiskGovernance.AdminUI.Infrastructure\Humaid.RiskGovernance.AdminUI.Infrastructure.csproj" />
    <ProjectReference Include="..\..\3-Service\Humaid.RiskGovernance.AdminUI.Services\Humaid.RiskGovernance.AdminUI.Services.csproj" />
    <ProjectReference Include="..\..\3-Service\Humaid.RiskGovernance.AdminUI.AI\Humaid.RiskGovernance.AdminUI.AI.csproj" />
    <ProjectReference Include="..\..\4-Persistence\Humaid.RiskGovernance.AdminUI.DA\Humaid.RiskGovernance.AdminUI.DA.csproj" />
  </ItemGroup>

</Project>
