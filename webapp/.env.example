# Copy to .env.local and fill in from your Auth0 application.
# These are only the LOCAL / build-time fallback: when the API serves /config.json (it does
# whenever AUTH0_DOMAIN / AUTH0_CLIENT_ID / AUTH0_AUDIENCE are set on it, including every deployed
# container) non-empty runtime values win over these.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# This repo's own backend (Humaid.RiskGovernance.AdminUI.Web).
VITE_API_BASE_URL=http://localhost:5210
