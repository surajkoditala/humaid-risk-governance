    <ProjectReference Include="..\..\src\3-Service\Humaid.RiskGovernance.AdminUI.Services\Humaid.RiskGovernance.AdminUI.Services.csproj" />
    <ProjectReference Include="..\..\src\3-Service\Humaid.RiskGovernance.AdminUI.AI\Humaid.RiskGovernance.AdminUI.AI.csproj" />
