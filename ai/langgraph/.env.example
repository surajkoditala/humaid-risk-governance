# Copy to .env and fill in. Same "only activate when configured" rule as the rest of this repo -
# see ai/README.md's AI_PROVIDER table for what each of these maps to on the .NET side.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: only needed if this service is pointed at Azure AI Foundry instead of Anthropic direct.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL_DEPLOYMENT=

# Optional: Google Gemini, via langchain-google-genai. Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Which model provider the graphs actually call - see app/llm.py. One of: anthropic | gemini | foundry
LLM_PROVIDER=gemini

PORT=8100
